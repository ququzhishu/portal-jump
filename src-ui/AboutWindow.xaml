<Window x:Class="PortalJump.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 折返跃迁 Portal Jump"
        Width="680" Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        Background="{StaticResource CanvasBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextPrimaryBrush}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="132" />
      <RowDefinition Height="*" />
      <RowDefinition Height="72" />
    </Grid.RowDefinitions>

    <!-- ============ 头图：品牌渐变 + 立绘插画 + 圆头像 ============ -->
    <Border Grid.Row="0" Background="{StaticResource BrandBrush}">
      <Grid ClipToBounds="True">

        <!-- 立绘插画（有素材时显示）：只取素材右侧的人物，左侧渐隐融入渐变底 -->
        <Border x:Name="HeroArt" Width="350" HorizontalAlignment="Right"
                VerticalAlignment="Stretch" IsHitTestVisible="False">
          <Border.Background>
            <ImageBrush x:Name="HeroBrush" Stretch="UniformToFill"
                        AlignmentX="Right" AlignmentY="Center" />
          </Border.Background>
          <Border.OpacityMask>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#00FFFFFF" Offset="0" />
              <GradientStop Color="#99FFFFFF" Offset="0.35" />
              <GradientStop Color="#FFFFFFFF" Offset="0.8" />
            </LinearGradientBrush>
          </Border.OpacityMask>
        </Border>

        <!-- 圆形头像：必须用 Ellipse 承载 —— Border 的 ClipToBounds 只按矩形裁剪，
             方形素材的四个角会直接盖在渐变上（实测表现就是"圆圈里有个白方块"） -->
        <Grid Width="84" Height="84" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,24,0,0">
          <Ellipse Fill="#3DFFFFFF" />
          <Ellipse x:Name="AvatarFill">
            <Ellipse.Fill>
              <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
            </Ellipse.Fill>
          </Ellipse>
          <Ellipse Stroke="#D9FFFFFF" StrokeThickness="3" />
        </Grid>

        <!-- 文字块（左边缘统一 136） -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="136,26,0,0">
          <TextBlock Text="折返跃迁" FontSize="28" FontWeight="Bold" Foreground="White" />
          <TextBlock Text="Portal Jump" FontSize="15" FontWeight="SemiBold"
                     Foreground="#E8FFFFFF" Margin="0,3,0,0" />
          <TextBlock x:Name="HeroDesc" FontSize="12.5" Foreground="#E0FFFFFF"
                     Margin="0,11,0,0" TextWrapping="NoWrap" />
        </StackPanel>

        <!-- 版本（右上）：加深色底片，压在插画上也能看清 -->
        <Border Background="#3D000000" CornerRadius="9" Padding="10,3"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,22,0">
          <TextBlock x:Name="VersionText" FontWeight="SemiBold" Foreground="#F2FFFFFF" />
        </Border>
      </Grid>
    </Border>

    <!-- ============ 内容：两张卡片 ============ -->
    <StackPanel Grid.Row="1" Margin="20,14,20,12">

      <!-- 应用信息 -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="应用信息" Style="{StaticResource CardTitle}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="104" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="版本" Style="{StaticResource FieldLabel}" />
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="VerValue" Style="{StaticResource FieldValue}" Margin="0,5" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="软件说明" Style="{StaticResource FieldLabel}" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DescValue" Style="{StaticResource FieldValue}" Margin="0,5" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="显卡" Style="{StaticResource FieldLabel}" Margin="0,5,14,0" />
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="GpuValue" Style="{StaticResource FieldValue}" Margin="0,5" TextWrapping="Wrap" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="当前显示模式" Style="{StaticResource FieldLabel}" />
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ModeValue" Style="{StaticResource FieldValue}" Margin="0,5" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="配置文件" Style="{StaticResource FieldLabel}" />
            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="IniValue" Style="{StaticResource FieldValue}" Margin="0,5" />
            <Button Grid.Row="4" Grid.Column="2" Content="打开" Style="{StaticResource SecondaryButton}"
                    Height="30" MinWidth="68" Margin="12,0,0,0" Click="OpenIni_Click" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="运行日志" Style="{StaticResource FieldLabel}" />
            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="LogValue" Style="{StaticResource FieldValue}" Margin="0,5" />
            <Button Grid.Row="5" Grid.Column="2" Content="打开" Style="{StaticResource SecondaryButton}"
                    Height="30" MinWidth="68" Margin="12,0,0,0" Click="OpenLog_Click" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- 作者 -->
      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Text="作者" Style="{StaticResource CardTitle}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="104" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="社交主页" Style="{StaticResource FieldLabel}" />
            <Button x:Name="AuthorLink" Grid.Column="1" Style="{StaticResource LinkButton}"
                    FontSize="15" Click="AuthorLink_Click" />
            <TextBlock x:Name="AuthorUrl" Grid.Column="2" Style="{StaticResource HintText}"
                       Margin="14,0,0,0" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- ============ 底栏 ============ -->
    <Border Grid.Row="2" Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="24,0,24,0">
        <TextBlock x:Name="FooterText" Style="{StaticResource HintText}" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="环境自检" Style="{StaticResource SecondaryButton}" Click="SelfTest_Click" />
          <Button Content="关闭" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="Close_Click" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
