<Window x:Class="PortalJump.UI.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择要关联的程序 — 折返跃迁"
        Width="900" Height="660" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="12.5"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <!-- ================= 本窗口局部样式（做法照抄 SettingsWindow） ================= -->
  <Window.Resources>

    <!-- 半透明卡片：底纹能从卡片里透出来（对比 WinForms：那边要手写一整套透明链）。
         列表整块用它当底，所以不会出现任何不透明白底。 -->
    <Style x:Key="GlassCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Background" Value="#C4FFFFFF" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270"
                            Color="#8B4CA8" Opacity="0.16" />
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 半透明输入框（筛选框）：和白底不透明说再见 -->
    <Style x:Key="FieldBox" TargetType="TextBox">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="#D9FFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
    </Style>

    <!-- 列表行：勾选/悬停都用半透明淡紫，底纹照旧透出来。
         WinForms 版用空 ImageList 把行距撑到 28，这里用 MinHeight 达到同样效果。 -->
    <Style x:Key="ProcRow" TargetType="ListViewItem">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="RowBg" Background="Transparent" CornerRadius="6" Margin="2,0" Padding="0,1">
              <!-- 必须用 GridViewRowPresenter（ListViewItem 的 Content 不是普通内容，
                   直接用 ContentPresenter 的话三个列都不会渲染）。
                   列集合走附加属性 GridView.ColumnCollection。 -->
              <GridViewRowPresenter VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    Columns="{Binding Path=(GridView.ColumnCollection),
                                              RelativeSource={RelativeSource TemplatedParent}}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RowBg" Property="Background" Value="#80F3ECFA" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="RowBg" Property="Background" Value="#C4E3D5F7" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 表头：默认模板用的是不透明的主题底色，这里换成半透明白 + 一条下边线 -->
    <Style x:Key="ProcHeader" TargetType="GridViewColumnHeader">
      <Setter Property="Height" Value="32" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridViewColumnHeader">
            <Grid>
              <Border x:Name="HeadBg" Background="#B0FFFFFF"
                      BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <ContentPresenter Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="Center" />
              </Border>
              <!-- 列宽拖拽手柄：默认模板里靠这个 Thumb 才能拖动列宽，重写模板时要补回来 -->
              <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="8"
                     Cursor="SizeWE" Opacity="0">
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent" />
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HeadBg" Property="Background" Value="#D9F3ECFA" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 三列的单元格：勾选框只在第一列，和 WinForms 版 ListView 的位置一致 -->
    <DataTemplate x:Key="NameCell">
      <Grid Margin="8,0,4,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                  Focusable="False" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="7,0,0,0"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource TextPrimaryBrush}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="TitleCell">
      <TextBlock Text="{Binding Title}" Margin="8,0" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis"
                 Foreground="{StaticResource TextSecondaryBrush}" />
    </DataTemplate>

    <DataTemplate x:Key="FileCell">
      <TextBlock Text="{Binding File}" Margin="8,0" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis"
                 Foreground="{StaticResource TextHintBrush}" />
    </DataTemplate>

  </Window.Resources>

  <!-- ================= 结构（自上而下：品牌渐变头图 / 工具条 / 列表 / 底栏） ================= -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="88" />
      <RowDefinition Height="60" />
      <RowDefinition Height="*" />
      <RowDefinition Height="76" />
    </Grid.RowDefinitions>

    <!-- ========== 顶栏：品牌渐变（对齐 WinForms 的 HeroPanel） ========== -->
    <Border Grid.Row="0" Background="{StaticResource BrandBrush}">
      <StackPanel Margin="26,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="选择要关联的程序" FontSize="17.5" FontWeight="Bold" Foreground="White" />
        <!-- 说明文字压在品牌渐变上，所以这里不能用 HintText（那是紫灰色，在渐变上看不清），
             沿用 WinForms 版的 #E2FFFFFF -->
        <TextBlock Text="勾选后点“确定”。没在运行的程序，可以用下面的“浏览 exe 文件…”。"
                   FontSize="12" Foreground="#E2FFFFFF" Margin="0,5,0,0" />
      </StackPanel>
    </Border>

    <!-- ========== 工具条：筛选 / 只看有窗口的程序 / 刷新 ========== -->
    <Grid Grid.Row="1" Margin="26,0,24,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="100" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0" Text="筛选" Style="{StaticResource FieldLabel}"
                 HorizontalAlignment="Left" Margin="0,0,10,0"
                 AutomationProperties.Name="筛选" />
      <TextBox x:Name="FilterBox" Grid.Column="1" Style="{StaticResource FieldBox}"
               VerticalAlignment="Center" Margin="0,0,20,0"
               AutomationProperties.Name="筛选" TextChanged="OnFilterChanged" />
      <CheckBox x:Name="OnlyWindowedBox" Grid.Column="2" Content="只看有窗口的程序"
                VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"
                AutomationProperties.Name="只看有窗口的程序"
                Checked="OnOnlyWindowedChanged" Unchecked="OnOnlyWindowedChanged" />
      <Button Grid.Column="3" Content="刷新列表" Style="{StaticResource SecondaryButton}"
              Height="34" MinWidth="100" HorizontalAlignment="Right" VerticalAlignment="Center"
              AutomationProperties.Name="刷新列表" Click="OnRefresh" />
    </Grid>

    <!-- ========== 列表：整块放在半透明卡片里 ========== -->
    <Border Grid.Row="2" Style="{StaticResource GlassCard}" Margin="20,0,20,12">
      <!-- 故意不给 AutomationProperties.Name：WinForms 版的 ListView 本来就没有 UIA 名字，
           探针靠“没有名字的列表”识别它（和 SettingsWindow 里预设列表的处理一致） -->
      <ListView x:Name="ProcList" Margin="6" Background="Transparent" BorderThickness="0"
                ItemContainerStyle="{StaticResource ProcRow}"
                MouseDoubleClick="OnRowDoubleClick">
        <ListView.Resources>
          <!-- 细滚动条。主题里的 ThinScrollBar 只按竖排调好（模板里的 Track 没绑 Orientation），
               横排会画错方向，所以这里补一个横向模板；横排只在把窗口拖窄时才出现。 -->
          <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}">
            <Style.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="8" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                      <Grid Background="Transparent">
                        <Track x:Name="PART_Track" Orientation="Horizontal">
                          <Track.Thumb>
                            <Thumb>
                              <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                  <Border CornerRadius="4" Background="#C9B6E0" Margin="0,1" />
                                </ControlTemplate>
                              </Thumb.Template>
                            </Thumb>
                          </Track.Thumb>
                          <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" />
                          </Track.IncreaseRepeatButton>
                          <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" />
                          </Track.DecreaseRepeatButton>
                        </Track>
                      </Grid>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Trigger>
            </Style.Triggers>
          </Style>
        </ListView.Resources>
        <ListView.View>
          <!-- 列宽和 WinForms 版一致：210 / 300 / 300 -->
          <GridView ColumnHeaderContainerStyle="{StaticResource ProcHeader}">
            <GridViewColumn Header="进程名" Width="210" CellTemplate="{StaticResource NameCell}" />
            <GridViewColumn Header="窗口标题" Width="300" CellTemplate="{StaticResource TitleCell}" />
            <GridViewColumn Header="文件路径" Width="300" CellTemplate="{StaticResource FileCell}" />
          </GridView>
        </ListView.View>
      </ListView>
    </Border>

    <!-- ========== 底栏：半透明白 + 上边线（对齐 WinForms 的 BarPanel(true)） ========== -->
    <Border Grid.Row="3" Background="#D2FFFFFF"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="24,0">
        <TextBlock x:Name="StatusText" Style="{StaticResource HintText}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <!-- 从右往左：确定 / 取消 / 全不选 / 浏览 exe 文件…（和 WinForms 版同序） -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="浏览 exe 文件…" Style="{StaticResource SecondaryButton}"
                  Height="38" MinWidth="140" AutomationProperties.Name="浏览 exe 文件…"
                  Click="OnBrowse" />
          <Button Content="全不选" Style="{StaticResource SecondaryButton}"
                  Height="38" MinWidth="88" Margin="8,0,0,0" AutomationProperties.Name="全不选"
                  Click="OnClearAll" />
          <!-- IsCancel：按钮关窗时 DialogResult=false，同时接管 Esc（对齐 WinForms 的 CancelButton） -->
          <Button Content="取消" Style="{StaticResource SecondaryButton}"
                  Height="38" MinWidth="88" Margin="8,0,0,0" AutomationProperties.Name="取消"
                  IsCancel="True" />
          <Button Content="确定" Style="{StaticResource PrimaryButton}"
                  Height="38" MinWidth="88" Margin="8,0,0,0" AutomationProperties.Name="确定"
                  IsDefault="True" Click="OnOk" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
