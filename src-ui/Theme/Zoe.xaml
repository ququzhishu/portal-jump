<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- ==================================================================
       折返跃迁 设计系统（佐伊主题：橙 → 粉 → 淡紫）
       所有界面只引用这里的资源，换配色只改这一个文件。
       ================================================================== -->

  <!-- ========== 颜色 ========== -->
  <Color x:Key="ZoeOrangeColor">#FF9E4F</Color>
  <Color x:Key="ZoePinkColor">#FF7FAE</Color>
  <Color x:Key="ZoePurpleColor">#C06CDE</Color>
  <Color x:Key="AccentColor">#B04FC4</Color>
  <Color x:Key="AccentHoverColor">#C464D6</Color>
  <Color x:Key="CanvasColor">#FBF8FE</Color>
  <Color x:Key="CardColor">#FFFFFF</Color>
  <Color x:Key="BorderColor">#E9DDF6</Color>
  <Color x:Key="BorderStrongColor">#D6C1ED</Color>
  <Color x:Key="TextPrimaryColor">#2B1D35</Color>
  <Color x:Key="TextSecondaryColor">#67546F</Color>
  <Color x:Key="TextHintColor">#9986A7</Color>
  <Color x:Key="TintColor">#F9F1FE</Color>

  <!-- ========== 画刷 ========== -->
  <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
  <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextHintBrush" Color="{StaticResource TextHintColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="TintBrush" Color="{StaticResource TintColor}" />
  <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF" />

  <!-- 品牌渐变（橙 → 粉 → 淡紫），头图与主按钮共用 -->
  <LinearGradientBrush x:Key="BrandBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="{StaticResource ZoeOrangeColor}" Offset="0" />
    <GradientStop Color="{StaticResource ZoePinkColor}" Offset="0.52" />
    <GradientStop Color="{StaticResource ZoePurpleColor}" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ButtonBrush" StartPoint="0,0" EndPoint="1,0.45">
    <GradientStop Color="#FF9A4D" Offset="0" />
    <GradientStop Color="#D95FC9" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ButtonHoverBrush" StartPoint="0,0" EndPoint="1,0.45">
    <GradientStop Color="#FFB066" Offset="0" />
    <GradientStop Color="#E874D8" Offset="1" />
  </LinearGradientBrush>

  <!-- ========== 字体 ========== -->
  <FontFamily x:Key="UiFont">Microsoft YaHei UI, Microsoft YaHei, Segoe UI</FontFamily>
  <sys:Double x:Key="FontBody">12.5</sys:Double>
  <sys:Double x:Key="FontHint">11</sys:Double>
  <sys:Double x:Key="FontTitle">17</sys:Double>
  <sys:Double x:Key="FontHero">28</sys:Double>

  <!-- ========== 卡片 ========== -->
  <Style x:Key="Card" TargetType="Border">
    <!-- 半透明白：让底纹透出来（各窗口可再覆盖得更透） -->
    <Setter Property="Background" Value="#C4FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="20,16,20,18" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect Color="#8B4CA8" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.14" />
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CardTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="Margin" Value="0,0,0,14" />
  </Style>

  <!-- 字段名（右对齐）+ 字段值 -->
  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,14,0" />
  </Style>
  <Style x:Key="FieldValue" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="HintText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontHint}" />
    <Setter Property="Foreground" Value="{StaticResource TextHintBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ========== 按钮 ========== -->
  <!-- 主按钮：品牌渐变 + 白字 -->
  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Height" Value="36" />
    <Setter Property="MinWidth" Value="88" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bg" CornerRadius="9" Background="{StaticResource ButtonBrush}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{StaticResource ButtonHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bg" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bg" Property="Background" Value="#F3EDF8" />
              <Setter Property="Foreground" Value="{StaticResource TextHintBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 次按钮：白底描边 -->
  <Style x:Key="SecondaryButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    <Setter Property="Height" Value="36" />
    <Setter Property="MinWidth" Value="80" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bg" CornerRadius="9" Background="#D9FFFFFF"
                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Background" Value="#E4EDE4F7" />
              <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bg" Property="Opacity" Value="0.85" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 链接按钮：无底、强调色、悬停下划线 -->
  <Style x:Key="LinkButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="Transparent">
            <TextBlock x:Name="txt" Text="{TemplateBinding Content}" Margin="{TemplateBinding Padding}"
                       VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="txt" Property="TextDecorations" Value="Underline" />
              <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ========== 细滚动条（原生 WPF 滚动条样式） ========== -->
  <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
    <Setter Property="Width" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border CornerRadius="4" Background="#C9B6E0" Margin="1,0" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
              </Track.IncreaseRepeatButton>
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
              </Track.DecreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
