<Window x:Class="PortalJump.UI.CustomResolutionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620" Height="556"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Title="创建自定义分辨率"
        Background="{StaticResource CanvasBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <Window.Resources>
    <Style x:Key="GlassCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Background" Value="#C4FFFFFF" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Color="#8B4CA8" Opacity="0.16" />
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FieldBox" TargetType="TextBox">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="#D9FFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style x:Key="FieldCombo" TargetType="ComboBox">
      <Setter Property="Height" Value="34" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="#D9FFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    </Style>

    <Style x:Key="StepButton" TargetType="RepeatButton">
      <Setter Property="Width" Value="19" />
      <Setter Property="Height" Value="16" />
      <Setter Property="FontSize" Value="8" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="Background" Value="#E8FFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="88" />
      <RowDefinition Height="*" />
      <RowDefinition Height="66" />
    </Grid.RowDefinitions>

    <!-- 品牌渐变头 -->
    <Border Grid.Row="0" Background="{StaticResource BrandBrush}">
      <StackPanel Margin="26,0,26,0" VerticalAlignment="Center">
        <TextBlock Text="创建自定义分辨率" FontSize="17" FontWeight="Bold" Foreground="White" />
        <TextBlock Margin="0,6,0,0" FontSize="12.5" Foreground="#E2FFFFFF" TextWrapping="Wrap"
                   Text="交给 NVIDIA 驱动新建一个分辨率，先试用、确认画面正常再保留。" />
      </StackPanel>
    </Border>

    <!-- 表单 -->
    <Border Grid.Row="1" Style="{StaticResource GlassCard}" Margin="16,10,16,0">
      <Grid Margin="24,14,24,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="104" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="52" />
          <RowDefinition Height="52" />
          <RowDefinition Height="52" />
          <RowDefinition Height="58" />
          <RowDefinition Height="52" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="宽度" Style="{StaticResource FieldLabel}"
                   AutomationProperties.Name="宽度" />
        <Grid Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="TxtW" Grid.Column="0" Style="{StaticResource FieldBox}"
                   AutomationProperties.Name="宽度输入" TextChanged="OnSizeChanged" />
          <StackPanel Grid.Column="1" Margin="3,0,0,0" VerticalAlignment="Center">
            <RepeatButton Content="▲" Style="{StaticResource StepButton}" Click="OnWidthUp" />
            <RepeatButton Content="▼" Style="{StaticResource StepButton}" Margin="0,2,0,0" Click="OnWidthDown" />
          </StackPanel>
          <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                     Style="{StaticResource HintText}" Text="像素（320 ~ 16384）" />
        </Grid>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="高度" Style="{StaticResource FieldLabel}"
                   AutomationProperties.Name="高度" />
        <Grid Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="TxtH" Grid.Column="0" Style="{StaticResource FieldBox}"
                   AutomationProperties.Name="高度输入" TextChanged="OnSizeChanged" />
          <StackPanel Grid.Column="1" Margin="3,0,0,0" VerticalAlignment="Center">
            <RepeatButton Content="▲" Style="{StaticResource StepButton}" Click="OnHeightUp" />
            <RepeatButton Content="▼" Style="{StaticResource StepButton}" Margin="0,2,0,0" Click="OnHeightDown" />
          </StackPanel>
          <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                     Style="{StaticResource HintText}" Text="像素（320 ~ 16384）" />
        </Grid>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="刷新率" Style="{StaticResource FieldLabel}"
                   AutomationProperties.Name="刷新率" />
        <Grid Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="TxtHz" Grid.Column="0" Style="{StaticResource FieldBox}"
                   AutomationProperties.Name="刷新率输入" />
          <StackPanel Grid.Column="1" Margin="3,0,0,0" VerticalAlignment="Center">
            <RepeatButton Content="▲" Style="{StaticResource StepButton}" Click="OnHzUp" />
            <RepeatButton Content="▼" Style="{StaticResource StepButton}" Margin="0,2,0,0" Click="OnHzDown" />
          </StackPanel>
          <TextBlock x:Name="HzHint" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                     TextWrapping="Wrap" Style="{StaticResource HintText}"
                     Text="推荐填显示器支持的最高刷新率" />
        </Grid>

        <!-- 宽视距：以当前显示器的横向长度为基准，纵向按 9/N 换算（自动填入宽高，再点"创建并试用"） -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="宽视距" Style="{StaticResource FieldLabel}"
                   AutomationProperties.Name="宽视距" />
        <StackPanel Grid.Row="3" Grid.Column="1" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnUltra219" Content="21:9 宽视距" Style="{StaticResource SecondaryButton}"
                    Height="32" MinWidth="128" AutomationProperties.Name="21:9 宽视距"
                    Click="OnUltrawide21" />
            <Button x:Name="BtnUltra329" Content="32:9 超宽视距" Style="{StaticResource SecondaryButton}"
                    Height="32" MinWidth="132" Margin="10,0,0,0"
                    AutomationProperties.Name="32:9 超宽视距" Click="OnUltrawide32" />
            <TextBlock x:Name="BaseWidthHint" Margin="12,0,0,0" VerticalAlignment="Center"
                       Style="{StaticResource HintText}" />
          </StackPanel>
          <TextBlock x:Name="AspectHint" Margin="0,4,0,0" TextWrapping="Wrap"
                     Style="{StaticResource HintText}"
                     Text="以显示器当前横向长度为基准，纵向按比例换算后自动填入。" />
        </StackPanel>
        <TextBlock Grid.Row="4" Grid.Column="0" Text="时序标准" Style="{StaticResource FieldLabel}"
                   AutomationProperties.Name="时序标准" />
        <ComboBox x:Name="CmbTiming" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center"
                  Width="320" HorizontalAlignment="Left" Style="{StaticResource FieldCombo}"
                  AutomationProperties.Name="时序标准下拉" />

        <TextBlock Grid.Row="5" Grid.Column="1" VerticalAlignment="Top" Margin="0,4,0,0"
                   TextWrapping="Wrap" Style="{StaticResource HintText}"
                   Text="点「创建并试用」后屏幕会临时切过去：确认画面正常再点保留，否则 15 秒后自动还原。" />
      </Grid>
    </Border>

    <!-- 底部按钮 -->
    <Grid Grid.Row="2" Margin="16,0,16,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Content="取消" Style="{StaticResource SecondaryButton}" Height="38" MinWidth="96"
                AutomationProperties.Name="取消" Click="OnCancel" />
        <Button Content="创建并试用" Style="{StaticResource PrimaryButton}" Height="38" MinWidth="132"
                Margin="10,0,0,0" AutomationProperties.Name="创建并试用" Click="OnCreate" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
