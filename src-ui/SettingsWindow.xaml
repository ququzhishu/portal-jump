<Window x:Class="PortalJump.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1200" Height="700" MinWidth="1060" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Title="Portal Jump"
        Background="{StaticResource CanvasBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <!-- ================= 本窗口局部样式 ================= -->
  <Window.Resources>

    <!-- 卡片：**完全不透明白**（原来是 #C4FFFFFF 77% 白）。
         半透明会让背景插画透上来，把卡片染成 #F3E8EF 之类的色调，
         连带提示文字对比度掉到 4.2:1（低于 WCAG AA 的 4.5）。
         与 WinForms 版（CardPanel.FillAlpha=255）采用同一决策。
         底纹仍在卡片之间、顶栏与底栏透出，氛围没有丢。 -->
    <Style x:Key="GlassCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Background" Value="#FFFFFFFF" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270"
                            Color="#8B4CA8" Opacity="0.16" />
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 输入框：**纯白底**（原来是 #D9FFFFFF 85% 白）。
         卡片改成不透明后，输入框若仍半透明，会与卡片产生可见的浅色差块。
         两者同色 = 视觉上"没有底色块"，只剩边框提示可输入。
         注：这里能保留半透明且不出现色差问题，是因为卡片已经完全不通明白；
         但为了与 WinForms 版的纯白处理保持一致，仍统一改成 #FFFFFF。 -->
    <Style x:Key="FieldBox" TargetType="TextBox">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="#FFFFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style x:Key="FieldCombo" TargetType="ComboBox">
      <Setter Property="Height" Value="34" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="#FFFFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    </Style>

    <Style x:Key="ComboItem" TargetType="ComboBoxItem">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- 预设条目：选中时左侧一条品牌色竖条 + 淡紫底 -->
    <Style x:Key="PresetItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Border x:Name="Bg" Background="Transparent" CornerRadius="8" />
              <Border x:Name="Bar" Width="4" CornerRadius="2" Margin="0"
                      HorizontalAlignment="Left" Background="Transparent" />
              <ContentPresenter Margin="12,6,10,6" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#F3ECFA" />
                <Setter TargetName="Bar" Property="Background" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#F7F2FC" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 恢复目标小标签 -->
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource ButtonBrush}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="9,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

  </Window.Resources>

  <!-- ================= 结构 ================= -->
  <Grid>
    <!-- 底纹：内容与 WinForms 版一致（复用核心里的 Backdrop.Veil 乘法混色） -->
    <Image x:Name="BackdropImage" Stretch="Fill" IsHitTestVisible="False" />

    <Grid>
      <Grid.RowDefinitions>
        <!-- 顶部品牌区 78 → 装 17pt 品牌字 -->
        <RowDefinition Height="78" />
        <RowDefinition Height="*" />
        <!-- 按钮栏 -->
        <RowDefinition Height="92" />
        <!-- 设备参数栏（独立成栏，横跨整个底边） -->
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ========== 顶部品牌区 ==========
           按用户要求：不加入图标，只有「Portal Jump」文字，字体加粗放大。
           字体用 Cascadia Code（OFL-1.1 开源，等宽技术感），降级到 Segoe UI。
           设备信息已移到底部独立栏，这里只留身份与操作。 -->
      <Border Grid.Row="0" Background="#D2FFFFFF" BorderThickness="0,0,0,1"
              BorderBrush="{StaticResource BorderBrush}">
        <Grid Margin="24,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="120" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" x:Name="BrandTitle" Text="Portal Jump"
                     FontFamily="Cascadia Code, Cascadia Mono, Consolas, Segoe UI"
                     FontSize="26" FontWeight="Bold"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     VerticalAlignment="Center"
                     AutomationProperties.Name="Portal Jump" />

          <Button x:Name="BtnAbout" Grid.Column="1" Content="关于" Style="{StaticResource LinkButton}"
                  HorizontalAlignment="Center" AutomationProperties.Name="关于" Click="OnAbout" />
          <Button Grid.Column="2" Content="重新检测" Style="{StaticResource SecondaryButton}"
                  Height="34" MinWidth="104" HorizontalAlignment="Right" Margin="0,0,0,0"
                  AutomationProperties.Name="重新检测" Click="OnRescan" />
        </Grid>
      </Border>

      <!-- ========== 两张卡片 ========== -->
      <Grid Grid.Row="1" Margin="16,10,16,0">
        <Grid.ColumnDefinitions>
          <!-- 两列等宽（原来是 * 和 0.95*，右卡比左卡窄 5%，
               两张卡片右边缘不对齐，看起来是"错位"）。
               左右都用 * 让两卡严格等宽；中间 14 是卡片间距。 -->
          <ColumnDefinition Width="*" MinWidth="400" />
          <ColumnDefinition Width="14" />
          <ColumnDefinition Width="*" MinWidth="520" />
        </Grid.ColumnDefinitions>

        <!-- 预设列表卡 -->
        <Border Grid.Column="0" Style="{StaticResource GlassCard}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="44" />
              <RowDefinition Height="*" />
              <RowDefinition Height="56" />
              <RowDefinition Height="44" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="预设" Style="{StaticResource CardTitle}"
                       AutomationProperties.Name="预设" />

            <!-- 注意：这里故意不给 AutomationProperties.Name —— 探针靠"没有名字的 List"来识别预设列表 -->
            <ListBox x:Name="PresetList" Grid.Row="1" Margin="12,0,12,0"
                     Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource PresetItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnPresetSelected">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Summary}" FontSize="12.5" Margin="0,3,0,0"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource Chip}"
                            Visibility="{Binding RestoreVisibility}" Margin="8,0,0,0">
                      <TextBlock Text="恢复目标" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="2" Margin="12,0,12,0" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="新增" Style="{StaticResource PrimaryButton}"
                      Height="36" Margin="0,0,5,0" AutomationProperties.Name="新增" Click="OnAddPreset" />
              <Button Grid.Column="1" Content="复制" Style="{StaticResource SecondaryButton}"
                      Height="36" Margin="5,0" AutomationProperties.Name="复制" Click="OnCopyPreset" />
              <Button Grid.Column="2" Content="删除" Style="{StaticResource SecondaryButton}"
                      Height="36" Margin="5,0" AutomationProperties.Name="删除" Click="OnDeletePreset" />
              <Button Grid.Column="3" Content="上移" Style="{StaticResource SecondaryButton}"
                      Height="36" Margin="5,0" AutomationProperties.Name="上移" Click="OnMoveUp" />
              <Button Grid.Column="4" Content="下移" Style="{StaticResource SecondaryButton}"
                      Height="36" Margin="5,0,0,0" AutomationProperties.Name="下移" Click="OnMoveDown" />
            </Grid>

            <CheckBox x:Name="ChkRestore" Grid.Row="3" Margin="16,0,12,0" VerticalAlignment="Center"
                      Content="所有关联程序退出后，自动恢复到本预设"
                      AutomationProperties.Name="所有关联程序退出后，自动恢复到本预设"
                      Checked="OnRestoreToggled" Unchecked="OnRestoreToggled" />
          </Grid>
        </Border>

        <!-- 预设详情卡 -->
        <Border Grid.Column="2" Style="{StaticResource GlassCard}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="44" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="预设详情" Style="{StaticResource CardTitle}"
                       AutomationProperties.Name="预设详情" />

            <Grid Grid.Row="1" Margin="20,0,20,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="46" />
                <RowDefinition Height="46" />
                <RowDefinition Height="46" />
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" Style="{StaticResource FieldLabel}"
                         AutomationProperties.Name="名称" />
              <TextBox x:Name="TxtName" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"
                       AutomationProperties.Name="名称" TextChanged="OnNameChanged" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="分辨率" Style="{StaticResource FieldLabel}"
                         AutomationProperties.Name="分辨率" />
              <Grid Grid.Row="1" Grid.Column="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="CmbRes" Grid.Column="0" Style="{StaticResource FieldCombo}"
                          ItemContainerStyle="{StaticResource ComboItem}"
                          AutomationProperties.Name="分辨率下拉"
                          SelectionChanged="OnResolutionPicked" />
                <Button Grid.Column="2" Content="创建自定义分辨率…" Style="{StaticResource SecondaryButton}"
                        Height="34" MinWidth="126" AutomationProperties.Name="创建自定义分辨率…"
                        Click="OnCreateCustomResolution" />
              </Grid>

              <TextBlock Grid.Row="2" Grid.Column="0" Text="自定义尺寸" Style="{StaticResource FieldLabel}"
                         AutomationProperties.Name="自定义尺寸" />
              <!-- 宽 × 高，右边跟「取当前分辨率」。
                   原来这里还插了两组加减按钮，网格列定义也跟着错位（高度那组落进了 12px 的间隔列），
                   整行看着是歪的；按钮本身也多余，直接去掉。 -->
              <Grid Grid.Row="2" Grid.Column="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="14" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtW" Grid.Column="0" VerticalAlignment="Center"
                         Style="{StaticResource FieldBox}"
                         AutomationProperties.Name="宽" TextChanged="OnSizeTextChanged" />
                <TextBlock Grid.Column="1" Text="×" Margin="10,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox x:Name="TxtH" Grid.Column="2" VerticalAlignment="Center"
                         Style="{StaticResource FieldBox}"
                         AutomationProperties.Name="高" TextChanged="OnSizeTextChanged" />
                <Button Grid.Column="4" Content="取当前分辨率" Style="{StaticResource SecondaryButton}"
                        Height="34" MinWidth="112" VerticalAlignment="Center"
                        AutomationProperties.Name="取当前分辨率"
                        Click="OnTakeCurrentResolution" />
              </Grid>

              <TextBlock Grid.Row="3" Grid.Column="0" Text="缩放方式" Style="{StaticResource FieldLabel}"
                         AutomationProperties.Name="缩放方式" />
              <ComboBox x:Name="CmbScaling" Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldCombo}"
                        ItemContainerStyle="{StaticResource ComboItem}"
                        AutomationProperties.Name="缩放方式下拉"
                        SelectionChanged="OnScalingPicked" />

              <TextBlock Grid.Row="4" Grid.Column="0" Text="关联程序" Style="{StaticResource FieldLabel}"
                         AutomationProperties.Name="关联程序" />
              <TextBox x:Name="TxtProcess" Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldBox}"
                       AutomationProperties.Name="关联程序" TextChanged="OnProcessTextChanged" />

              <TextBlock Grid.Row="5" Grid.Column="1" VerticalAlignment="Top" Margin="0,6,0,0"
                         TextWrapping="Wrap" Style="{StaticResource HintText}"
                         Text="填进程名（不含 .exe），多个用分号隔开；命中后托盘会自动切到本预设。" />

              <Grid Grid.Row="6" Grid.Column="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="选择运行中的程序…" Style="{StaticResource SecondaryButton}"
                        Height="36" AutomationProperties.Name="选择运行中的程序…" Click="OnPickProcesses" />
                <Button Grid.Column="2" Content="清空关联" Style="{StaticResource SecondaryButton}"
                        Height="36" AutomationProperties.Name="清空关联" Click="OnClearProcesses" />
              </Grid>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- ========== 按钮栏 ========== -->
      <Border Grid.Row="2" Background="#D2FFFFFF" BorderThickness="0,1,0,0"
              BorderBrush="{StaticResource BorderBrush}">
        <Grid Margin="24,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- 设备信息已移到最底部独立栏，这里只留状态提示与两个开关 -->
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock x:Name="StatusText" Style="{StaticResource HintText}" Height="22"
                       TextTrimming="CharacterEllipsis" />
            <CheckBox x:Name="ChkAutoSwitch" Content="托盘常驻时自动跟随程序切换" Margin="0,2,0,0"
                      AutomationProperties.Name="托盘常驻时自动跟随程序切换"
                      Checked="OnAutoSwitchToggled" Unchecked="OnAutoSwitchToggled" />
            <CheckBox x:Name="ChkAutoStart" Content="开机自动启动（登录后常驻托盘）" Margin="0,6,0,0"
                      AutomationProperties.Name="开机自动启动（登录后常驻托盘）"
                      Checked="OnAutoStartToggled" Unchecked="OnAutoStartToggled" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="放弃改动并重载" Style="{StaticResource SecondaryButton}" Height="38" MinWidth="130"
                    AutomationProperties.Name="放弃改动并重载" Click="OnReload" />
            <Button Content="仅应用（测试）" Style="{StaticResource SecondaryButton}" Height="38" MinWidth="118"
                    Margin="10,0,0,0" AutomationProperties.Name="仅应用（测试）" Click="OnApplyOnly" />
            <Button Content="保存" Style="{StaticResource SecondaryButton}" Height="38" MinWidth="88"
                    Margin="10,0,0,0" AutomationProperties.Name="保存" Click="OnSave" />
            <Button Content="保存并应用" Style="{StaticResource PrimaryButton}" Height="38" MinWidth="128"
                    Margin="10,0,0,0" AutomationProperties.Name="保存并应用" Click="OnSaveAndApply" />
            <Button Content="关闭" Style="{StaticResource SecondaryButton}" Height="38" MinWidth="88"
                    Margin="10,0,0,0" AutomationProperties.Name="关闭" Click="OnClose" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ========== 设备参数栏（最底部，独立成栏，横跨整个底边）==========
           显卡型号加粗放大、当前模式次一级 —— 字号比原来放大约 30%。
           与 WinForms 版 (_hwBar) 的排布一致。 -->
      <Border Grid.Row="3" Background="#F2FFFFFF" BorderThickness="0,1,0,0"
              BorderBrush="{StaticResource BorderBrush}" MinHeight="64">
        <StackPanel Margin="24,10,24,12" VerticalAlignment="Center">
          <TextBlock x:Name="LblEnv" FontSize="15" FontWeight="Bold"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="LblCurrent" FontSize="13.5" Margin="0,5,0,0"
                     Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
